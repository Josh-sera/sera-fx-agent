# ─── Required: LLM provider (pick one) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # Claude Sonnet 4.6 (recommended default)
# OPENAI_API_KEY=sk-...               # or GPT-5.4 (configured as fallback)


# ─── sera-mcp location (canonical execution MCP) ───────────────────────────
# This agent expects sera-mcp to be cloned + built separately.
#   git clone https://github.com/Josh-sera/sera-mcp.git ~/sera-mcp
#   cd ~/sera-mcp && npm install && npm run build
# Override SERA_MCP_DIST if your dist lives elsewhere.
SERA_MCP_DIST=/Users/your-user/sera-mcp/dist/index.js


# ─── sera-mcp runtime (forwarded into the spawned MCP) ─────────────────────
SERA_NETWORK=mainnet                  # canonical: mainnet via api.sera.cx
POLICY_PRESET=standard                # standard | strict | dry-run-only
LOG_LEVEL=info

# Optional gates (sera-mcp reads these directly):
# SERA_API_KEY=...                    # treasury / rebalance / pay_invoice
# SERA_HISTORY_DB=/Users/your-user/.sera/history.db   # fx_history / fx_volatility / corridor_pnl
# SERA_DAILY_VOLUME_CAP_USD=100000
# SERA_DRY_RUN=true                   # kill switch — every execute returns a dry-run trace


# ─── sera-fx-tools runtime (this repo's read-only thinking MCP) ────────────
# Defaults to api.sera.cx mainnet REST. Override only if you're running a private
# Sera deployment or pointing at a non-canonical mirror.
# SERA_API_BASE=https://api.sera.cx/api/v1
# SERA_FX_TOOLS_ALLOW_NONSTANDARD_HOST=false


# ─── Wallet identity (optional — for signing orders) ───────────────────────
# Neither MCP holds a key. EIP-712 quote params come back from sera.get_quote;
# your wallet client signs them. Listed only because some integrations
# (ERC-8004 registration, x402) want a signer.
PRIVATE_KEY=...


# ─── Optional integrations ─────────────────────────────────────────────────
COINBASE_API_KEY=...                  # AgentKit / x402 micropayments
BINANCE_API_KEY=...                   # If your skills need CEX reference data
BINANCE_SECRET=...
